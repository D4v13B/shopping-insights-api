# Copiar a .env antes de `docker compose up --build`:  cp .env.example .env
# Variables del stack completo (db, migrate, etl, etl-worker, api y web).
# Para un entorno real, cambiar TODAS las contraseñas, la API key y las credenciales de Kaggle.
#
# Despliegue: clonar shopping-insights-etl, shopping-insights-api y shopping-insights-web
# como carpetas HERMANAS y ejecutar docker compose desde ESTE repo (shopping-insights-api).

# --- PostgreSQL (superusuario: dueño del esquema y de las migraciones) ---
POSTGRES_DB=shopping
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# --- Roles de mínimo privilegio (los crea infra/postgres/init-roles.sh) ---
ETL_DB_PASSWORD=change-me-etl
API_DB_PASSWORD=change-me-api

# --- Cadenas de conexión (las contraseñas deben coincidir con las de arriba) ---
DATABASE_URL_MIGRATE=postgresql://postgres:change-me@db:5432/shopping
DATABASE_URL_ETL=postgresql://etl_writer:change-me-etl@db:5432/shopping
DATABASE_URL_API=postgresql://api_reader:change-me-api@db:5432/shopping

# --- Kaggle (ETL: descarga en runtime; respaldo en shopping-insights-etl/data/shopping_trends.csv) ---
# Prueba técnica: la API KEY y el usuario se cargan aquí para que el evaluador pueda probar la
# descarga desde Kaggle. Si están vacíos o falla la red, el ETL usa el CSV versionado en el repo
# del ETL (no depende solo de la API de Kaggle). Rotar o revocar la clave tras la evaluación.
KAGGLE_USERNAME=dbusta0215@gmail.com
KAGGLE_KEY=KGAT_a29166bb694709c69127f3a892e9907b

# --- API ---
# Clave para POST /api/v1/etl/run (mínimo 16 caracteres)
ETL_API_KEY=change-me-long-random-key
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Token compartido web→API: las peticiones SSR (todas desde la IP del contenedor web) no cuentan
# para el rate limit. Mínimo 16 caracteres.
INTERNAL_API_TOKEN=change-me-internal-token

# --- Web ---
# URL de la API desde el servidor de la web (red interna de Docker)
API_INTERNAL_URL=http://api:8080
# URL de la API desde el navegador (se incrusta en el bundle al construir)
VITE_API_URL=http://localhost:8080

# --- Ubicación de los otros repos para el build (por defecto, carpetas hermanas) ---
# ETL_REPO=../shopping-insights-etl
# WEB_REPO=../shopping-insights-web
